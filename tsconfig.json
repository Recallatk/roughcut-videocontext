{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        /* Allow existing JS files to be imported by TS files without converting them */
        "allowJs": true,
        "checkJs": false,
        /* Strict type checking */
        "strict": true,
        "noImplicitAny": true,
        /* Emit nothing — Vite handles the build */
        "noEmit": true,
        /* Allow default imports from CommonJS modules */
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        /* Source maps for editor navigation */
        "sourceMap": true,
        /* Output declarations when .ts files are added later */
        "declaration": true,
        "declarationDir": "./dist/types",
        "skipLibCheck": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "test"
    ]
}