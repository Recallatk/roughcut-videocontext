{
    "name": "@recallatk/videocontext",
    "version": "0.54.0-roughcut.7.1",
    "type": "module",
    "description": "A WebGL & HTML5 graph-based video composition engine. Maintained fork of BBC VideoContext.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Recallatk/roughcut-videocontext.git"
    },
    "license": "Apache-2.0",
    "main": "dist/videocontext.js",
    "module": "dist/videocontext.esm.js",
    "exports": {
        "import": "./dist/videocontext.esm.js",
        "require": "./dist/videocontext.js"
    },
    "keywords": [
        "video",
        "composition",
        "timeline",
        "webgl",
        "html5",
        "browser",
        "effects",
        "transitions"
    ],
    "contributors": [
        {
            "name": "Matthew Shotton",
            "email": "matthew.shotton@bbc.co.uk"
        },
        {
            "name": "RoughCut (Recallatk)",
            "url": "https://github.com/Recallatk"
        }
    ],
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "test": "vitest run",
        "test-unit": "vitest run test/unit",
        "test-integration": "vitest run test/integration",
        "test-watch": "vitest",
        "test-coverage": "vitest run --coverage",
        "test-e2e": "npm run build && playwright test",
        "test-e2e:update": "npm run build && playwright test --update-snapshots",
        "test-e2e:ui": "npm run build && playwright test --ui",
        "format": "prettier --write '{src,test}/**/*.{js,ts}'",
        "typecheck": "tsc --noEmit",
        "lint": "eslint 'src/**/*.{js,ts}' 'test/**/*.js'",
        "postversion": "git push -u origin HEAD --follow-tags",
        "prepare": "husky"
    },
    "engines": {
        "node": ">=22"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.59.1",
        "@vitest/coverage-v8": "^4.1.4",
        "eslint": "^10.2.0",
        "globals": "^17.5.0",
        "husky": "^9.1.7",
        "jsdom": "^29.0.2",
        "prettier": "^3.8.3",
        "serve": "^14.2.6",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.2",
        "vite": "^8.0.8",
        "vitest": "^4.1.4",
        "webgl-mock": "^0.1.7"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    }
}
